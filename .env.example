# Başlangıç noktası (isteğe bağlı; web arayüzünden haritadan da seçilebilir)
# TRAFIK_LAT=41.0451
# TRAFIK_LON=29.0340
# TRAFIK_NAME=Boğaziçi Köprüsü

# Web arayüzü şifresi (zorunlu, kullanıcı adı boş bırakılabilir)
ADMIN_PASSWORD=
# Seçilen konumun saklandığı dosya (Dokploy'da /data volume'üne bağlanır)
# STATE_PATH=data/state.json

# https://developer.tomtom.com adresinden ücretsiz key
TOMTOM_API_KEY=

# @BotFather ile bot oluştur, chat id için bota mesaj atıp
# https://api.telegram.org/bot<TOKEN>/getUpdates adresine bak
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kontrol periyodu (saniye). TomTom ücretsiz katman ~2500 istek/gün => 300 sn güvenli
CHECK_INTERVAL_SECONDS=300
# Güncel hız / serbest akış hızı oranı eşikleri
YOGUN_ESIK=0.40
ORTA_ESIK=0.70
