# https://developer.tomtom.com adresinden ücretsiz key
TOMTOM_API_KEY=

# @BotFather ile bot oluştur. Her kullanıcı kendi chat id'sini arayüzden girer;
# kullanıcılar botuna Telegram'dan bir kez mesaj atmış (Start demiş) olmalı.
TELEGRAM_BOT_TOKEN=

# Oturum çerezi imza anahtarı (boşsa otomatik üretilip DATA_DIR/secret_key'de saklanır)
# SECRET_KEY=
# Doluysa kayıt olmak için bu davet kodu gerekir. Boşsa kayıt herkese açıktır!
# REGISTRATION_CODE=
# Kullanıcı başına en fazla nokta (TomTom kotasını korur)
# MAX_POINTS_PER_USER=5

# Veritabanının tutulduğu dizin (Docker'da /data volume'ü)
# DATA_DIR=data
# Yerelde http ile denerken çerez Secure olmasın (HTTPS arkasında bunu 1 bırak)
# COOKIE_SECURE=0

# Ölçüm periyodu (saniye). TomTom ücretsiz katman ~2500 istek/gün:
# toplam nokta sayısı x (86400 / periyot) bunu aşmamalı.
CHECK_INTERVAL_SECONDS=300
# Güncel hız / serbest akış hızı oranı eşikleri
YOGUN_ESIK=0.40
ORTA_ESIK=0.70
# Saat aralıklarının yorumlandığı saat dilimi
TIMEZONE=Europe/Istanbul
